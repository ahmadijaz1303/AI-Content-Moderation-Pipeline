# Provider keys: configure in server-side secret management only.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_VISION_MODEL=models/gemini-flash-latest
OPENROUTER_VISION_MODEL=openrouter/free
GEMINI_TIMEOUT_SECONDS=30

# Local runtime paths and dependencies.
MODERATION_MODEL_DIRECTORY=models
TESSERACT_CMD=
STT_MODEL_SIZE=small
BACKEND_LONG_VIDEO_SECONDS=20
API_MAX_UPLOAD_BYTES=2147483648
API_UPLOAD_CHUNK_BYTES=1048576
